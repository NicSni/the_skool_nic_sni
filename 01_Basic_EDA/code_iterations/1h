SET PAGESIZE 50

SELECT 
UTBILDNINGSOMRÅDE,
COUNT (STUDIEFORM) AS Total
COUNT (CASE WHEN STUDIEFORM = 'Bunden' THEN 1 END) AS Bunden
COUNT (CASE WHEN STUDIEFORM = 'Distans' THEN  END) AS Distans
COUNT (CASE WHEN BESLUT = 'Beviljad' THEN 1 END) AS Beviljad
FROM myhresults
    WHERE BESLUT = 'Beviljad'
    GROUP BY UTBILDNINGSOMRÅDE
    ORDER BY Beviljad DESC;
EXIT
